<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="pdf_processor" uuid="9F8E5B6D-6E4F-22EF-9B3C-1353BD230003">
	<description>Example: add a footer and encryption to a PDF, as described in config.ini</description>
	<target name="pdf_processor">
		<root class="PDF_PROCESSOR_APP" feature="make"/>
		<file_rule>
			<exclude>/\..*$</exclude>
			<exclude>/EIFGENs$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="total_order_on_reals" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<library name="epdf" location="..\epdf.ecf"/>
		<cluster name="example" location=".\" recursive="true"/>
	</target>
</system>
