<?xml version="1.0" encoding="ISO-8859-1"?>
<system 
	xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" 
	name="stream" uuid="75A0428A-668C-43DD-8788-2E2EE72AAB96" library_target="stream">
	<description>STREAM interfaces to read and write IO</description>
	<target name="stream">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="error">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<cluster name="input" location=".\input" recursive="true">
			<file_rule>
				<exclude>/EIFGENs$</exclude>
				<exclude>/\..*$</exclude>
			</file_rule>
		</cluster>
	</target>
</system>
