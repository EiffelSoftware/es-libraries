		<description>EiffelTUI Examples Suite &amp; Runner</description>
		<root class="EXAMPLE_RUNNER" feature="make"/>
		<setting name="executable_name" value="example_runner"/>
		<cluster name="examples" location=".\examples\" recursive="true"/>
	</target>

