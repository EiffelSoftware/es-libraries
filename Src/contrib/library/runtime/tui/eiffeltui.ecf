<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd"
        name="eiffeltui"
        uuid="E1FFE170-0001-4000-8000-000000000001"
        library_target="eiffeltui">

	<target name="eiffeltui">
		<description>EiffelTUI core library target</description>
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\.git$</exclude>
			<exclude>/\.svn$</exclude>
		</file_rule>
		<option warning="warning" syntax="standard" manifest_array_type="mismatch_warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="total_order_on_reals" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="thread"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="thread" location="$ISE_LIBRARY\library\thread\thread.ecf"/>
		<cluster name="eiffeltui" location=".\library\" recursive="true">
			<file_rule>
				<exclude>/platform$</exclude>
			</file_rule>
		</cluster>
		<cluster name="eiffeltui_windows" location=".\library\platform\windows\">
			<description>Win32 console driver; TERMINAL_DRIVER inherits WIN32_CONSOLE_DRIVER</description>
			<condition>
				<platform value="windows"/>
			</condition>
		</cluster>
		<cluster name="eiffeltui_posix" location=".\library\platform\posix\">
			<description>POSIX tty driver; TERMINAL_DRIVER inherits POSIX_CONSOLE_DRIVER</description>
			<condition>
				<platform excluded_value="windows"/>
			</condition>
		</cluster>
	</target>

	<target name="eiffeltui_demo" extends="eiffeltui">
		<description>EiffelTUI Phase 1 Hello World Demo</description>
		<root class="HELLO_TUI" feature="make"/>
		<setting name="executable_name" value="hello_tui"/>
		<cluster name="demo" location=".\demo\" recursive="true"/>
	</target>

	<target name="eiffeltui_tests" extends="eiffeltui">
		<description>EiffelTUI Autotest Suite</description>
		<root class="TEST_APP" feature="make"/>
		<setting name="executable_name" value="eiffeltui_tests"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<cluster name="tests" location=".\tests\" recursive="true">
			<option>
				<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
			</option>
			<file_rule>
				<exclude>/platform$</exclude>
			</file_rule>
		</cluster>
		<cluster name="tests_windows" location=".\tests\platform\windows\">
			<condition>
				<platform value="windows"/>
			</condition>
		</cluster>
		<cluster name="tests_posix" location=".\tests\platform\posix\">
			<condition>
				<platform excluded_value="windows"/>
			</condition>
		</cluster>
		<cluster name="examples" location=".\examples\" recursive="true"/>
	</target>

