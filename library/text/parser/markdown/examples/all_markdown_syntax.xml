    <text>Line Breaks</text>
  </heading>
  <heading level="3">
    <text>Hard Line Breaks ✅</text>
  </heading>
  <paragraph>
    <text>This line ends with two spaces</text>
    <softbreak/>
    <linebreak/>
    <text>and continues on the next line.</text>
  </paragraph>
  <paragraph>
    <text>This line ends with a backslash</text>
    <softbreak/>
    <linebreak/>
    <text>and continues on the next line.</text>
  </paragraph>
  <heading level="3">
    <text>Soft Line Breaks ✅</text>
  </heading>
  <paragraph>
    <text>This is a single paragraph</text>
    <softbreak/>
    <text>that spans multiple lines</text>
    <softbreak/>
    <text>but renders as one paragraph.</text>
  </paragraph>
  <heading level="2">
    <text>Emphasis and Strong ✅</text>
  </heading>
  <paragraph>
    <emph>
      <text>This is emphasized text</text>
    </emph>
    <softbreak/>
    <emph>
      <text>This is also emphasized (underscore) ✅</text>
    </emph>
  </paragraph>
  <paragraph>
    <strong>
      <text>This is strong text</text>
    </strong>
    <softbreak/>
    <strong>
      <text>This is also strong (underscore) ✅</text>
    </strong>
  </paragraph>
  <paragraph>
    <strong>
      <emph>
        <text>This is both emphasized and strong</text>
      </emph>
    </strong>
    <softbreak/>
    <strong>
      <emph>
        <text>This is also both (underscore) ✅</text>
      </emph>
    </strong>
  </paragraph>
