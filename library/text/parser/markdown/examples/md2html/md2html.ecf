<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="md2html" uuid="F18D6BB0-1C8A-4F2E-8C56-8C0C6B1A16D9">
	<target name="md2html">
		<root class="MD2HTML" feature="make"/>
		<file_rule>
			<exclude>/\..*$</exclude>
			<exclude>/EIFGENs$</exclude>
		</file_rule>
		<option warning="error"/>
		<setting name="console_application" value="true"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="markdown" location="..\..\markdown.ecf" readonly="false"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
</system>

