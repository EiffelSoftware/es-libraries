package eiffeltui

project
	eiffeltui = "eiffeltui.ecf"

note
	title: EiffelTUI
	description: "[
		Native Eiffel Terminal User Interface (TUI) library, inspired by Rust's Ratatui.
		Immediate-mode rendering with double buffering and diffing, constraint-based layouts,
		styled text, widgets (block, paragraph, list, table, tabs, gauge, sparkline,
		bar chart, canvas, chart, scrollbar, calendar, text input, tree, popup),
		keyboard and mouse events, inline and fullscreen modes.
		Written in pure Eiffel with inlined C console API, void-safe, thread-based input.
	]"
	tags: tui, terminal, console, widget, ui, ratatui
	category: contrib
	license: Eiffel Forum License v2 (see http://www.eiffel.com/licensing/forum.txt)
	copyright: 2025-2026 Javier Velilla, Eiffel Software and others
	link[license]: http://www.eiffel.com/licensing/forum.txt
	maps: /com.eiffel/contrib/library/runtime/tui

end
