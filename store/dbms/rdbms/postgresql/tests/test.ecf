<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="test_postgresql" uuid="685CC95A-77EE-4574-86A1-E2657473D492">
	<description>PostgreSQL access library for EiffelStore.</description>
	<target name="test_postgresql">
		<description>PostgreSQL unit tests using AutoTest.</description>
		<root class="TEST" feature="make"/>
		<file_rule>
			<exclude>/EIFGENs*</exclude>
			<exclude>/\..*</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
			<warning name="obsolete_feature" value="all"/>
		</option>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency support="thread"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="postgresql" location="..\postgresql.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<tests name="tests" location=".\">
			<file_rule>
				<exclude>/EIFGENs*</exclude>
				<exclude>/\..*</exclude>
			</file_rule>
		</tests>
	</target>
</system>
